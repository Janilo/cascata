# Secrets — configure via `wrangler secret put` (nunca no repo)
# SUPABASE_SERVICE_ROLE_KEY=

# IA — usada pelas Edge Functions (extract-customers / extract-inputs).
# Configurar como SECRETS DO SUPABASE (Edge Functions → Secrets), não no Worker.
# Sem nada disso, usa o gateway do Lovable + LOVABLE_API_KEY (fallback).
# Para sair do Lovable, basta setar estes 2 (ex.: OpenRouter):
# AI_GATEWAY_URL="https://openrouter.ai/api/v1"
# AI_API_KEY=          # chave do provider de IA
# LOVABLE_API_KEY=     # fallback atual
